export const TABLE_SAVED_DESTINATIONS = 'SAVED_DESTINATIONS';

export const COL_ID = 'ID';

export const COL_NAME = 'NAME';

export const COL_ADDRESS = 'ADDRESS';

export const COL_LATITUDE = 'LATITUDE';

export const COL_LONGITUDE = 'LONGITUDE';

export const COL_CREATED_AT = 'CREATEDAT';

export const SQL_CREATE_SAVED_DESTINATIONS = `
  CREATE TABLE IF NOT EXISTS ${TABLE_SAVED_DESTINATIONS} (
    ${COL_ID} INTEGER PRIMARY KEY AUTOINCREMENT,
    ${COL_NAME} TEXT,
    ${COL_ADDRESS} TEXT,
    ${COL_LATITUDE} REAL NOT NULL,
    ${COL_LONGITUDE} REAL NOT NULL,
    ${COL_CREATED_AT} INTEGER
  )
`;
