export const SQL_CREATE_OLD_TRIPS = `
  CREATE TABLE IF NOT EXISTS ${TABLE_OLD_TRIPS} (
    ${COL_TRIP_ID} INTEGER PRIMARY KEY AUTOINCREMENT,
    ${COL_TRIP_RIDE_ID} TEXT NOT NULL,
    ${COL_TRIP_STATUS} TEXT NOT NULL,
    ${COL_TRIP_DRIVER_NAME} TEXT,
    ${COL_TRIP_DRIVER_RATING} REAL,
    ${COL_TRIP_VEHICLE_PLATE} TEXT,
    ${COL_TRIP_VEHICLE_MODEL} TEXT,
    ${COL_TRIP_VEHICLE_COLOR} TEXT,
    ${COL_TRIP_DRIVER_PHOTO_URL} TEXT,
    ${COL_TRIP_DRIVER_PHONE} TEXT,
    ${COL_TRIP_PICKUP_ADDRESS} TEXT NOT NULL,
    ${COL_TRIP_PICKUP_LAT} REAL NOT NULL,
    ${COL_TRIP_PICKUP_LNG} REAL NOT NULL,
    ${COL_TRIP_DROP_OFF_ADDRESS} TEXT,
    ${COL_TRIP_DROP_OFF_LAT} REAL,
    ${COL_TRIP_DROP_OFF_LNG} REAL,
    ${COL_TRIP_DRIVER_DISTANCE_KM} REAL NOT NULL,
    ${COL_TRIP_DISTANCE_KM} REAL,
    ${COL_TRIP_COST} REAL,
    ${COL_TRIP_CURRENCY} TEXT,
    ${COL_TRIP_COMPLETED_AT} INTEGER
  )
`;
